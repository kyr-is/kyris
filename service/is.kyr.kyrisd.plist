<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>is.kyr.kyrisd</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{BINARY_PATH}}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <!--
        launchd waits this long for kyrisd to exit after SIGTERM before
        sending SIGKILL. Matches design/kyris.md §5.2's 30-second drain
        timeout — gives the daemon room to finish in-flight HTTP requests
        and persist the session-token table before forced termination.
    -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>5</integer>
    <key>WorkingDirectory</key>
    <string>{{HOME}}/.kyris</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{HOME}}</string>
        <key>PATH</key>
        <string>{{PATH}}</string>
    </dict>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <!-- Both stdout and stderr land in one file. kyrisd writes
         exclusively through tracing (which targets stderr); stdout sees
         nothing under normal operation, but we still merge so a stray
         println! from a dependency doesn't get silently discarded. Path
         lives under XDG_STATE_HOME so logs survive uninstall.
         install.sh creates ~/.local/state/kyris/log/ before launchd loads
         this plist; if the dir is missing, launchd silently drops output. -->
    <key>StandardOutPath</key>
    <string>{{HOME}}/.local/state/kyris/log/kyrisd.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/.local/state/kyris/log/kyrisd.log</string>
</dict>
</plist>
